# ════════════════════════════════════════════════════════════════════════
#  ATM GUARD — ORTAM DEĞİŞKENLERİ ŞABLONU
#  Banka sunucusunda:  cp .env.example .env   ve değerleri doldurun.
#  .env dosyası git'e GİRMEZ (gizli bilgiler güvende kalır).
# ════════════════════════════════════════════════════════════════════════

# ── BEYİN API SUNUCUSU (ai_engine/api_server.py) ─────────────────────────
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
# Prod'da KAPALI tutun (1 yaparsanız dosya değişiminde restart → state kaybı)
BRAIN_RELOAD=0
BRAIN_LOG_LEVEL=info

# ── CASH BEYNİ (AI nakit tahmini) ────────────────────────────────────────
# 1 = açık (ML kütüphaneleri + veri varsa AI tahmini kullanılır)
# 0 = kapalı (nakit kararları kural tabanlı — her durumda güvenli)
CASH_BRAIN_ENABLE=1
# Cash beyninin beslendiği kasa raporu (boşsa otomatik aranır)
# CASH_BRAIN_DATA=/opt/atmguard/kasa_durum_raporu.json

# ── BANKA VERİTABANI (SQL Feed Runner — canlı hortumlar) ─────────────────
# SQLAlchemy URL. Banka DB tipine göre birini kullanın:
#   Oracle   : oracle+oracledb://KULLANICI:PAROLA@host:1521/?service_name=BANKDB
#   MSSQL    : mssql+pyodbc://KULLANICI:PAROLA@host:1433/BANKDB?driver=ODBC+Driver+18+for+SQL+Server
#   Postgres : postgresql+psycopg2://KULLANICI:PAROLA@host:5432/bankdb
#   Test     : sqlite:///./mock_bank.db
BANK_DB_URL=sqlite:///./mock_bank.db
# SQL feed runner son-çalışma kayıtlarının dizini
# LAST_RUN_DIR=./feed_state

# ── FRONTEND (Next.js) → BEYİN bağlantısı ────────────────────────────────
# Sunucu tarafı API route'ları için
BRAIN_API_URL=http://localhost:8000
# Tarayıcı tarafı (public) — beyin adresini buraya yazın
NEXT_PUBLIC_BRAIN_URL=http://localhost:8000

# ── ZAMAN DİLİMİ ─────────────────────────────────────────────────────────
TZ=Europe/Istanbul
